    position: fixed;
    inset: 0;
    z-index: 80;
    background: var(--bg);
    color: var(--ink);
  }

  .preloader__sphere {
    position: absolute;
    left: 50%;
    top: 50%;
    width: rem(680);
    height: rem(680);
    margin: rem(-340) 0 0 rem(-340);
    display: block;

    @include mobile {
      width: rem(340);
      height: rem(340);
      margin: rem(-170) 0 0 rem(-170);
    }
  }

  .preloader__hud {
    position: absolute;
    top: var(--gutter);
    left: var(--gutter);
    right: var(--gutter);
    display: flex;
    justify-content: space-between;
  }

  .preloader__count {
    position: absolute;
    left: var(--gutter);
    bottom: rem(48);
    font-family: var(--font-display);
    font-weight: 800;
    font-stretch: 125%;
    font-size: rem(220);
    line-height: 0.8;
    color: var(--ink);

    @include mobile {
      font-size: rem(96);
    }
  }

  .preloader__bar {
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    bottom: var(--gutter);
    height: 1px;
    background: var(--line);

    span {
      display: block;
      height: 100%;
      background: var(--red);
      transform-origin: left;
      transform: scaleX(0);
    }
  }
</style>
