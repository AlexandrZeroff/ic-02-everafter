---
import { getImage } from 'astro:assets'
import Glyph from '@/components/atoms/Glyph/Glyph.astro'
import { lineup } from '@/data/content'

// one optimized URL per photo, so day switches can swap sources on the client
const unique = new Map<string, string>()
for (const day of lineup.days) {
  for (const artist of day.artists) {
    if (!unique.has(artist.image.src)) {
      const img = await getImage({
        src: artist.image,
        width: 900,
        format: 'webp',
        quality: 78,
      })
      unique.set(artist.image.src, img.src)
    }
  }
}
const days = lineup.days.map((day) => ({
  id: day.id,
  label: day.label,
  artists: day.artists.map(({ image, ...rest }) => ({
    ...rest,
    src: unique.get(image.src)!,
  })),
}))
const first = days[0]
---

<section class="lineup section" id="lineup" data-bg="0.8">
  <div class="lineup__head">
    <div>
      <span class="mono lineup__label">{lineup.label}</span>
      <h2 class="h-xl lineup__title">{lineup.title}</h2>
    </div>
    <div class="lineup__side">
      <span class="mono text-muted">{lineup.meta}</span>
      <div class="lineup__tabs mono" role="tablist">
        {days.map((day, i) => (
          <button
            class:list={['lineup__tab', { 'is-active': i === 0 }]}
            role="tab"
            data-day={i}
            aria-selected={i === 0}
          >
            {day.label}
          </button>
        ))}
      </div>
    </div>
  </div>

  <div class="lineup__stage">
    <div class="lineup__fire" aria-hidden="true">
      <span></span>
      <span></span>
      <span></span>
    </div>
    <ul class="lineup__list" data-days={JSON.stringify(days)}>
      {first.artists.map((artist, i) => (
        <li
          class:list={['lineup__item', { 'is-active': i === 0 }]}
          data-index={i}
        >
          <div class="lineup__photo duotone">
            <img src={artist.src} alt="" loading="lazy" decoding="async" />
          </div>
          <span class="lineup__no mono">{String(i + 1).padStart(2, '0')}</span>
          <span class="lineup__vname" data-field="name">
            {artist.name}
          </span>
          <div class="lineup__info">
            <span class="mono lineup__meta">
              <span data-field="stage">{artist.stage}</span> ·{' '}
              <span data-field="time">{artist.time}</span>
            </span>
            <h3 class="lineup__name" data-field="name">
              {artist.name}
            </h3>
            <div class="lineup__foot mono">
              <span class="text-muted" data-field="genre">
                {artist.genre}
              </span>
              <a href="#lineup" class="lineup__link" data-cursor="Listen">
                See artist <Glyph name="arrow" />
              </a>
            </div>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  import { gsap } from '@/scripts/gsap'
  import { scramble } from '@/scripts/scramble'
  import { reelMode } from '@/scripts/webgl'

  type Day = {
    label: string
    artists: {
      name: string
      stage: string
      time: string
      genre: string
      src: string
    }[]
  }

  const section = document.querySelector<HTMLElement>('.lineup')!
  const list = section.querySelector<HTMLElement>('.lineup__list')!
  const days = JSON.parse(list.dataset.days!) as Day[]
  const items = [...list.querySelectorAll<HTMLElement>('.lineup__item')]
  const tabs = [...section.querySelectorAll<HTMLButtonElement>('.lineup__tab')]
  let active = 0
  let day = 0
  let lastUser = 0
  let inView = false

  const glitch = (el: HTMLElement) => {
    el.classList.remove('is-glitch')
    void el.offsetWidth
    el.classList.add('is-glitch')
  }

  const setActive = (i: number) => {
    if (i === active) return
    items[active].classList.remove('is-active')
    active = i
    items[active].classList.add('is-active')
    glitch(items[active].querySelector('.lineup__photo')!)
    const info =
      items[active].querySelectorAll<HTMLElement>('.lineup__info > *')
    gsap.fromTo(
      info,
      { y: 24, autoAlpha: 0 },
      {
        y: 0,
        autoAlpha: 1,
        duration: 0.7,
        ease: 'expo.out',
        stagger: 0.05,
        delay: 0.15,
      },
    )
  }

  const setDay = (d: number) => {
    if (d === day) return
    day = d
    tabs.forEach((t, i) => {
      t.classList.toggle('is-active', i === d)
      t.setAttribute('aria-selected', String(i === d))
    })
    days[d].artists.forEach((artist, i) => {
      const item = items[i]
      if (!item) return
      item.querySelectorAll<HTMLElement>('[data-field]').forEach((f) => {
        const key = f.dataset.field as keyof typeof artist
        scramble(f, artist[key], 650 + i * 60)
      })
      const img = item.querySelector<HTMLImageElement>('img')!
      img.src = artist.src
      glitch(item.querySelector('.lineup__photo')!)
    })
  }

  items.forEach((item, i) => {
    item.addEventListener('pointerenter', () => {
      lastUser = performance.now()
      setActive(i)
    })
  })
  tabs.forEach((tab, i) =>
    tab.addEventListener('click', () => {
      lastUser = performance.now()
      setDay(i)
    }),
  )

  new IntersectionObserver(([e]) => (inView = e.isIntersecting), {
    threshold: 0.35,
  }).observe(list)

  // showreel: walk through artists, then through days
  let steps = 0
  setInterval(() => {
    if (!inView) return
    if (!reelMode && performance.now() - lastUser < 4000) return
    steps++
    if (steps % items.length === 0) setDay((day + 1) % days.length)
    setActive((active + 1) % items.length)
  }, 2400)

  // entrance: columns rise in
  gsap.from(items, {
    yPercent: 30,
    autoAlpha: 0,
    clipPath: 'inset(100% 0 0 0)',
    duration: 1.2,
    ease: 'expo.out',
    stagger: 0.06,
    scrollTrigger: { trigger: list, start: 'top 80%' },
  })
  gsap.from('.lineup__title', {
    fontVariationSettings: "'wdth' 62",
    letterSpacing: '0.1em',
    duration: 1.4,
    ease: 'expo.out',
    scrollTrigger: { trigger: '.lineup__title', start: 'top 85%' },
  })
</script>

<style lang="scss">
  .lineup {
    padding-top: rem(80);
    padding-bottom: rem(160);
    z-index: 1;
  }

  .lineup__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: rem(40);

    @include mobile {
      flex-direction: column;
      align-items: flex-start;
      gap: rem(20);
    }
  }

  .lineup__label {
    display: block;
    margin-bottom: rem(16);
  }

  .lineup__title {
    font-variation-settings: 'wdth' 125;
  }

  .lineup__side {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: rem(16);

    @include mobile {
      align-items: flex-start;
    }
  }

  .lineup__tabs {
    display: flex;
    border: 1px solid var(--line);
  }

  .lineup__tab {
    padding: rem(10) rem(16);
    transition:
      background-color 0.3s,
      color 0.3s;

    & + & {
      border-left: 1px solid var(--line);
    }

    &.is-active {
      background: var(--ink);
      color: var(--black);
    }

    &:not(.is-active):hover {
      color: var(--red);
    }

    @include mobile {
      padding: rem(8) rem(9);
      font-size: rem(10);
    }
  }

  .lineup__stage {
    position: relative;
    padding: rem(28);
    border: 1px solid var(--line);

    @include mobile {
      padding: rem(10);
    }
  }

  .lineup__fire {
    position: absolute;
    inset: 0;
    overflow: hidden;
    z-index: 0;

    span {
      position: absolute;
      border-radius: 50%;
      filter: blur(rem(60));
      opacity: 0.55;
      animation: drift 9s ease-in-out infinite alternate;
    }

    span:nth-child(1) {
      left: 5%;
      top: 20%;
      width: 45%;
      height: 90%;
      background: var(--red);
    }

    span:nth-child(2) {
      right: 0;
      top: -20%;
      width: 40%;
      height: 80%;
      background: var(--orange);
      animation-delay: -3s;
    }

    span:nth-child(3) {
      left: 40%;
      bottom: -30%;
      width: 35%;
      height: 70%;
      background: var(--pink);
      animation-delay: -6s;
    }
  }

  @keyframes drift {
    to {
      transform: translate(12%, -8%) scale(1.2);
    }
  }

  .lineup__list {
    position: relative;
    z-index: 1;
    list-style: none;
    padding: 0;
    display: flex;
    gap: rem(8);
    height: rem(560);

    @include mobile {
      height: rem(420);
      gap: rem(4);
    }
  }

  .lineup__item {
    position: relative;
    flex: 1 1 0;
    min-width: 0;
    overflow: hidden;
    background: rgba(10, 10, 10, 0.6);
    transition: flex-grow 0.9s var(--ease-out);

    &.is-active {
      flex-grow: 7;
    }
  }

  .lineup__photo {
    position: absolute;
    inset: 0;
    opacity: 0.25;
    transition: opacity 0.6s;

    .is-active & {
      opacity: 1;
    }

    &.is-glitch img {
      animation: glitch 0.45s steps(1) both;
    }
  }

  @keyframes glitch {
    0% {
      clip-path: inset(10% 0 60% 0);
      transform: translateX(-6%);
    }
    15% {
      clip-path: inset(50% 0 20% 0);
      transform: translateX(5%);
    }
    30% {
      clip-path: inset(0 0 80% 0);
      transform: translateX(-3%) scaleX(1.1);
    }
    45% {
      clip-path: inset(70% 0 0 0);
      transform: translateX(4%);
    }
    60% {
      clip-path: inset(20% 0 40% 0);
      transform: translateX(-2%);
    }
    80% {
      clip-path: inset(0 0 0 0);
      transform: translateX(1%);
    }
    100% {
      clip-path: inset(0 0 0 0);
      transform: none;
    }
  }

  .lineup__no {
    position: absolute;
    top: rem(14);
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;

    .is-active & {
      left: rem(20);
      transform: none;
    }
  }

  .lineup__vname {
    position: absolute;
    left: 50%;
    bottom: rem(18);
    z-index: 2;
    writing-mode: vertical-rl;
    transform: translateX(-50%) rotate(180deg);
    white-space: nowrap;
    font-family: var(--font-display);
    font-weight: 800;
    font-stretch: 100%;
    font-size: rem(30);
    line-height: 1;
    text-transform: uppercase;
    transition: opacity 0.3s;

    .is-active & {
      opacity: 0;
    }

    @include mobile {
      font-size: rem(16);
    }
  }

  .lineup__info {
    position: absolute;
    left: rem(24);
    right: rem(24);
    bottom: rem(24);
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: rem(10);
    opacity: 0;
    visibility: hidden;

    .is-active & {
      opacity: 1;
      visibility: visible;
    }

    @include mobile {
      left: rem(12);
      right: rem(12);
      bottom: rem(12);
    }
  }

  .lineup__meta {
    color: var(--ink);
  }

  .lineup__name {
    font-family: var(--font-display);
    font-weight: 800;
    font-stretch: 125%;
    font-size: rem(84);
    line-height: 0.88;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    white-space: nowrap;

    @include mobile {
      font-size: rem(30);
      white-space: normal;
    }
  }

  .lineup__foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: rem(12);
    border-top: 1px solid rgba(242, 239, 234, 0.3);
  }

  .lineup__link {
    display: inline-flex;
    align-items: center;
    gap: rem(6);

    &:hover {
      color: var(--red);
    }
  }
</style>
